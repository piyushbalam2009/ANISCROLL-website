        && isValidSiteConfigDoc(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (canManageSettings() || canManageArtwork());
      allow update: if isSignedIn() && isValidId(docId)
        && isValidSiteConfigDoc(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && canManageSettings()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'configId', 'siteName', 'siteDescription', 'preferEnglishLogos', 'autoArtworkScan',
          'artworkCacheTtlMinutes', 'maintenanceMode', 'maintenanceMessage', 'require2FAForAdmins', 'sessionTimeoutMinutes',
          'playerSettings', 'providerSettings', 'performanceSettings',
          'updatedByUid', 'updatedByEmail', 'updatedAt'
