    // Collection 14: Public User Profiles (/publicProfiles/{uid}) — Privacy Enforced, PII-Free
    match /publicProfiles/{uid} {
      allow get: if isValidId(uid) && (
        isOwner(uid)
        || canManageUsers()
        || resource.data.privacy.profileVisibility == 'public'
        || (isSignedIn() && resource.data.privacy.profileVisibility == 'members')
      );
      allow list: if isOwner(uid)
        || canManageUsers()
        || resource.data.privacy.profileVisibility == 'public'
        || (isSignedIn() && resource.data.privacy.profileVisibility == 'members');
      allow create: if isSignedIn() && isValidId(uid)
        && isValidPublicProfile(incoming())
        && incoming().uid == uid
        && (isOwner(uid) || canManageUsers())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isOwnerRole() || incoming().role in ['member', 'user'] || incoming().role == expectedCallerRole());
      allow update: if isSignedIn() && isValidId(uid)
        && isValidPublicProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(uid) && incoming().diff(existing()).affectedKeys().hasOnly([
            'username', 'displayName', 'bio', 'photoURL',
            'avatarCharacterId', 'avatarCharacterName', 'avatarAnimeName',
            'privacy', 'favouriteAnime', 'stats', 'recentActivity', 'joinedAt', 'updatedAt'
          ]))
          ||
          (canManageUsers()
            && !isModeratorOnly()
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'updatedAt'])
            && canAdminModifyTargetRole(existing(), incoming()))
          ||
          (canModeratorModerateTargetStatus(existing(), incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(uid)
        && (isOwner(uid) || (canManageUsers() && !isModeratorOnly() && existing().role != 'owner' && uid != 'ClYKhPNBohZuDPPS3upXVyQvUEq2'));
    }

    // Collection 15: Unique Username Reservations (/usernames/{username})
    match /usernames/{username} {
      allow get: if isValidId(username);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(username)
        && isValidUsernameReservation(incoming())
        && incoming().username == username
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(username)
        && isValidUsernameReservation(incoming())
        && incoming().username == username
        && existing().uid == request.auth.uid
        && incoming().uid == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && isValidId(username)
        && (existing().uid == request.auth.uid || isOwnerRole());
    }

    // Collection 16: Moderation Reports (/reports/{reportId})
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && isActiveAdmin();
      allow list: if isActiveAdmin();
      allow create: if isSignedIn() && isValidId(reportId)
        && isValidModerationReport(incoming())
        && incoming().id == reportId
        && incoming().reporterUid == request.auth.uid
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(reportId)
        && isActiveAdmin()
        && isValidModerationReport(incoming())
        && incoming().id == existing().id
        && incoming().reporterUid == existing().reporterUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'actionTaken', 'resolutionNote', 'resolvedByUid', 'resolvedByEmail', 'resolvedAt', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(reportId) && isOwnerRole();
    }

    // Collection 17: System & Upstream Error Logs (/errorLogs/{logId})
    match /errorLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && canViewErrorLogs();
      allow list: if canViewErrorLogs();
      allow create: if isSignedIn() && isValidId(logId)
        && isActiveAdmin()
        && isValidErrorLog(incoming())
        && incoming().id == logId
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(logId) && isOwnerRole();
    }

    // Collection 18: Server-Only Discord Account Links (/discordAccountLinks/{discordUserId})
    // Strictly denied to all direct browser/client reads and writes. Only accessible via trusted server-side Firebase Admin SDK.
    match /discordAccountLinks/{discordUserId} {
      allow read, write: if false;
    }

    // Collection 19: Server-Only Discord OAuth States (/discordOAuthStates/{stateId})
    // Strictly denied to all direct browser/client reads and writes. Only accessible via trusted server-side Firebase Admin SDK.
    match /discordOAuthStates/{stateId} {
      allow read, write: if false;
    }
  }
}
