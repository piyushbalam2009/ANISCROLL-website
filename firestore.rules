    // Collection 10: Announcements (/announcements/{announcementId})
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId);
      allow list: if request.time != null;
      allow create: if isSignedIn() && isValidId(announcementId)
        && isValidAnnouncementDoc(incoming())
