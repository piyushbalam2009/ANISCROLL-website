    // Entity Blueprint 14: ModerationReport (/reports/{reportId})
    function isValidModerationReport(data) {
      return data.keys().hasAll(['id', 'reporterUid', 'targetType', 'targetId', 'reason', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'reporterUid', 'reporterLabel', 'targetType', 'targetId', 'targetName',
