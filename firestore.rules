        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'role', 'status', 'permissions', 'addedBy', 'addedAt', 'lastLogin', 'invitedBy', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(adminUid)
        && existing().role != 'owner'
        && adminUid != 'ClYKhPNBohZuDPPS3upXVyQvUEq2'
        && (isOwnerRole() || (canManageUsers() && existing().role == 'editor'));
    }

    // Collection 7: Anime Artwork (/animeArtwork/{animeId})
    match /animeArtwork/{animeId} {
      allow get: if isValidId(animeId);
