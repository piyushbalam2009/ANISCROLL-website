    // Collection 1: User Profile (/users/{uid}/profile/{docId})
    match /users/{uid}/profile/{docId} {
      allow get: if (isOwner(uid) || canManageUsers()) && isValidId(uid) && isValidId(docId);
      allow list: if isOwner(uid) || canManageUsers();
      allow create: if isOwner(uid) && isValidId(uid) && isValidId(docId)
        && docId == 'details'
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && (!('status' in incoming()) || incoming().status == 'active')
        && (!('accountStatus' in incoming()) || incoming().accountStatus == 'active')
        && (!('role' in incoming()) || incoming().role in ['member', 'user'] || incoming().role == expectedCallerRole())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(uid) && isValidId(docId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Owner updates own profile fields (cannot self-escalate role or unban self)
          (isOwner(uid) && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'username', 'bio', 'email', 'photoURL',
            'avatarCharacterId', 'avatarCharacterName', 'avatarAnimeName',
            'provider', 'privacy', 'favouriteAnime', 'stats', 'recentActivity',
            'migrationCompleted', 'updatedAt'
          ]))
          ||
          // Action 2: Authorized Staff moderates status/role with hierarchy enforcement
          (canManageUsers()
            && !isModeratorOnly()
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'accountStatus', 'role', 'updatedAt'])
            && canAdminModifyTargetRole(existing(), incoming()))
          ||
          // Action 3: Moderator updates status ONLY on member accounts
          (canModeratorModerateTargetStatus(existing(), incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'accountStatus', 'updatedAt']))
        );
      allow delete: if (isOwner(uid) || (canManageUsers() && !isModeratorOnly() && existing().role != 'owner' && uid != 'ClYKhPNBohZuDPPS3upXVyQvUEq2')) && isValidId(uid) && isValidId(docId);
    }

    // CollectionGroup query support for Admin User Management (/users/*/profile/*)
    match /{path=**}/profile/{docId} {
      allow get, list: if canManageUsers();
    }

    // Collection 2: Watchlist (/users/{uid}/watchlist/{animeId})
    match /users/{uid}/watchlist/{animeId} {
      allow get: if isOwner(uid) && isValidId(uid) && isValidId(animeId);
