rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default deny all paths unless explicitly matched
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedOwner() {
      return isSignedIn() && (
        request.auth.uid == 'ClYKhPNBohZuDPPS3upXVyQvUEq2'
        || request.auth.token.email == 'balampiyush2009@gmail.com'
      );
    }

    function hasAdminDoc() {
      return isSignedIn() && firestore.exists(
        /databases/ai-studio-aniscroll-0233812b-caf8-4532-8f0f-c2cc33bb9580/documents/admins/$(request.auth.uid)
      );
    }

    function getAdminDoc() {
      return firestore.get(
        /databases/ai-studio-aniscroll-0233812b-caf8-4532-8f0f-c2cc33bb9580/documents/admins/$(request.auth.uid)
      ).data;
    }

    function canUploadArtwork() {
      return isBootstrappedOwner()
        || (
          hasAdminDoc()
          && getAdminDoc().status == 'active'
          && (
            getAdminDoc().role == 'owner'
            || getAdminDoc().permissions.uploadLogos == true
            || getAdminDoc().permissions.manageArtwork == true
          )
        );
    }

    function canDeleteArtwork() {
      return isBootstrappedOwner()
        || (
          hasAdminDoc()
          && getAdminDoc().status == 'active'
          && (
            getAdminDoc().role == 'owner'
            || getAdminDoc().permissions.deleteLogos == true
          )
        );
    }

    function isValidCustomLogoFile() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|webp)');
    }

    // Custom Transparent Anime Logos: /anime-logos/{animeId}/{fileName}
    match /anime-logos/{animeId}/{fileName} {
      allow read: if request.time != null;
      allow create, update: if canUploadArtwork()
        && animeId.size() >= 1
        && animeId.size() <= 64
        && fileName.size() >= 1
        && fileName.size() <= 180
        && isValidCustomLogoFile();
      allow delete: if canDeleteArtwork();
    }
  }
}
