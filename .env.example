# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HOSHIKA API OAuth Credentials (optional for public read metadata, used for authorized actions)
HOSHIKA_CLIENT_ID="MY_HOSHIKA_CLIENT_ID"
HOSHIKA_CLIENT_SECRET="MY_HOSHIKA_CLIENT_SECRET"

# FANART_API_KEY (or FANART_TV_API_KEY): Personal or Project API Key for Fanart.tv v3.2 artwork
# Recommended on Vercel: enables live Fanart.tv API calls; curated fallback used if unset.
FANART_API_KEY="MY_FANART_API_KEY"
FANART_TV_API_KEY=""

# Firebase Web App Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_DATABASE_ID=""

# Admin & Server-Side Firebase Admin SDK Configuration
ADMIN_OWNER_UID=""
ADMIN_OWNER_EMAIL="balampiyush2009@gmail.com"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Supabase Storage Server-Side Configuration (for Custom Anime Logos)
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_BUCKET="aniscroll-artwork"

# Optional Performance Diagnostics Logging ("true" | "false")
ANISCROLL_PERF_LOG="false"
